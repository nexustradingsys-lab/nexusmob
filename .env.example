# Nexus Mobile Production Configuration
# Non-secret configuration (Compose reads from .env)
# Credentials (KITE_API_KEY, KITE_API_SECRET) are injected via Docker Compose secrets:
#   secrets/kite_api_key.txt
#   secrets/kite_api_secret.txt
# Session state is managed via the persistent volume: data/auth/zerodha_session.json

HOST=0.0.0.0
PORT=8000
HOST_PORT=8000
NEXUS_BIND_ADDRESS=127.0.0.1
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=10
NSE_RETRIES=2
STAGE1_ARCHIVE_PATH=/var/lib/nexus-mobile/stage1/runs
MOBILE_AUTH_SESSION_PATH=/var/lib/nexus-mobile/auth/zerodha_session.json
